{
  "name": "sai-yip-api",
  "version": "1.0.0",
  "description": "SAI.YIP Backend API — Cloudflare Workers + Google Sheets",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:create": "wrangler d1 create sai-yip-db",
    "d1:migrate:local": "wrangler d1 migrations apply sai-yip-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply sai-yip-db",
    "secret:put": "wrangler secret put"
  },
  "devDependencies": {
    "wrangler": "^3.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
